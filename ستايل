:root {
  --red-main: #e11d2e;
  --red-dark: #8a0000;
  --gold: #f5c542;
  --text: #ffffff;
  --text-muted: #b0b0b5;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  /* استخدام صورتك كخلفية */
  background-image: url('bg.jpg'); /* إذا كانت png غير الامتداد إلى bg.png */
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-repeat: no-repeat;
  background-color: #050505;
  
  color: var(--text);
  font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center; /* توسيط المحتوى في منتصف الشاشة */
  overflow-x: hidden;
}

/* الحاوية الرئيسية التي تضم الأزرار فوق الصورة */
.main-container {
  width: 100%;
  max-width: 750px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* نزول بسيط لأسفل لتجنب تغطية الشعار العلوي */
  margin-top: 40px; 
}

/* اختيار الإصدار */
.fw-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  background: rgba(10, 10, 12, 0.8);
  backdrop-filter: blur(5px);
  border: 1px solid rgba(225, 29, 46, 0.6);
  border-radius: 12px;
  padding: 12px 25px;
  margin-bottom: 25px;
  width: 100%;
  box-shadow: 0 0 20px rgba(0,0,0,0.8);
}

.fw-selector label {
  font-size: 16px;
  font-weight: bold;
}

.fw-selector select {
  appearance: none;
  padding: 10px 20px;
  border-radius: 8px;
  border: 2px solid var(--red-main);
  background: #0a0a0c;
  color: #fff;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  outline: none;
  cursor: pointer;
  min-width: 180px;
  box-shadow: 0 0 10px rgba(225, 29, 46, 0.3);
}

/* زر GoldHEN الذهبي */
.goldhen-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  width: 100%;
  max-width: 600px;
  padding: 16px;
  border-radius: 50px;
  border: 3px solid var(--gold);
  background: rgba(10, 8, 2, 0.8);
  backdrop-filter: blur(5px);
  color: var(--gold);
  font-size: 26px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 0 25px rgba(245, 197, 66, 0.3);
  transition: 0.2s;
  margin-bottom: 25px;
}

.goldhen-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 40px rgba(245, 197, 66, 0.6), inset 0 0 20px rgba(245, 197, 66, 0.2);
}
.goldhen-btn .icon { font-size: 32px; }

/* الكروت الثلاثة */
.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  width: 100%;
  margin-bottom: 25px;
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 130px;
  border-radius: 12px;
  border: 2px solid var(--red-dark);
  background: rgba(15, 15, 18, 0.85);
  backdrop-filter: blur(5px);
  color: #fff;
  cursor: pointer;
  transition: 0.2s;
}

.card:hover {
  border-color: var(--red-main);
  transform: translateY(-3px);
  box-shadow: 0 0 20px rgba(225, 29, 46, 0.5);
}

.card-active {
  border-color: var(--red-main);
  background: rgba(42, 10, 14, 0.85);
  box-shadow: 0 0 20px rgba(225, 29, 46, 0.4);
}

.card-icon { font-size: 35px; }
.card-title { font-size: 20px; font-weight: bold; }

/* النصوص السفلية (النسخ) */
.version-links {
  display: flex;
  align-items: center;
  gap: 20px;
  color: var(--text-muted);
  font-size: 15px;
  font-weight: bold;
}
.version-links i {
  width: 2px;
  height: 16px;
  background: var(--red-main);
  display: inline-block;
}

/* ================= النوافذ المنبثقة ================= */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.overlay.hidden { display: none; }

.modal {
  position: relative;
  width: 100%;
  max-width: 500px;
  background: #0d0d0f;
  border: 2px solid var(--red-main);
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 0 30px rgba(225, 29, 46, 0.5);
}

.modal h2 { margin-bottom: 20px; text-align: center; font-size: 22px; }

.close {
  position: absolute;
  top: 15px;
  left: 15px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid var(--red-main);
  background: #1a1a1d;
  color: #fff;
  cursor: pointer;
}

.ip-label { display: block; text-align: center; color: var(--text-muted); margin-bottom: 8px; font-size: 14px; }
#ps4-ip {
  display: block;
  width: 100%;
  max-width: 280px;
  margin: 0 auto 10px;
  padding: 12px;
  border-radius: 10px;
  border: 1px solid var(--red-main);
  background: #0a0a0c;
  color: #fff;
  text-align: center;
  font-size: 16px;
}

.save-btn {
  display: block;
  margin: 0 auto 20px;
  padding: 10px 25px;
  border: none;
  border-radius: 8px;
  background: var(--red-main);
  color: #fff;
  font-weight: bold;
  cursor: pointer;
  font-size: 15px;
}

.modal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.tool-btn {
  padding: 15px;
  border-radius: 10px;
  border: none;
  color: #fff;
  font-weight: bold;
  cursor: pointer;
  font-size: 15px;
  transition: 0.2s;
}
.tool-btn:hover { filter: brightness(1.2); }
.tool-btn.red { background: #9f1220; }
.tool-btn.green { background: #0f7a36; }

.status {
  margin-top: 15px;
  padding: 12px;
  border-radius: 8px;
  background: rgba(225, 29, 46, 0.1);
  color: #ccc;
  text-align: center;
  font-size: 14px;
}

.app-link {
  display: flex;
  flex-direction: column;
  padding: 15px;
  border-radius: 10px;
  border: 1px solid rgba(225, 29, 46, 0.4);
  background: #141416;
  color: #fff;
  text-decoration: none;
  transition: 0.2s;
}
.app-link:hover { border-color: var(--red-main); background: #1a0505; }
.app-link strong { font-size: 16px; margin-bottom: 5px; }
.app-link span { font-size: 12px; color: var(--text-muted); }

/* التجاوب مع الموبايل */
@media (max-width: 768px) {
  .main-container { margin-top: 100px; } /* تنزيل المحتوى أكثر للموبايل */
  .cards { grid-template-columns: 1fr; }
  .card { min-height: 90px; flex-direction: row; gap: 15px; }
  .fw-selector { flex-direction: column; gap: 10px; padding: 15px; }
}
